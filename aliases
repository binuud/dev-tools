
# To checkout master branch, and pull merge master from origin
alias gitcpf="git checkout master;git pull origin master"

# enable python ai environment
alias py-env-3.9="source ~/Code/local/dev-tools/python-env/3.9/bin/activate"
alias py-env-3.14="source ~/Code/local/dev-tools/python-env/3.14/bin/activate"


## launch simple containers
alias container-alpine="docker run --rm -it -v .:/data -w /data  alpine sh"
alias container-busybox="docker run --rm -it -v .:/data -w /data busybox sh"
alias container-golang="docker run --rm -it -v .:/app -w /app binuud/golang:1.27.2"

alias container-aws-cli="docker run --rm -it -v ~/.aws:/root/.aws --entrypoint bash amazon/aws-cli"
alias container-npm="docker run --rm -it -v .:/app -p 4173:4173 -w /app --entrypoint sh  node:24-alpine"

## coding assistants
alias container-pi-dev="docker run --rm -it -v .:/workspace -w /workspace binuud/pi-dev:1.0"
alias container-pi-dev-golang="docker run --rm -it -v .:/workspace -w /workspace binuud/pi-dev-golang:1.0"

alias pip-install-requirements="pip install -r requirements.txt"

## llama.cpp aliases
alias llm-qwen-3.5="llama-cli -hf ggml-org/Qwen3.5-0.8B-GGUF -ngl 99 --jinja --port 12434 -fa"
alias llm-server-qwen-3.5="llama-server -hf ggml-org/Qwen3.5-0.8B-GGUF \
  -ngl 99 --jinja \
  --cors-origins "https://binuud.com"
  --port 11434"
alias check-mlx="python -c \"import mlx.core as mx; print('Metal available:', mx.metal.is_available())\""
